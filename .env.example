# 运行环境（复制为 .env 并填写；不要提交 .env）
# ---- FineBI 开放平台 ----
FINEBI_BASE_URL=http://127.0.0.1:8075
FINEBI_CLIENT_ID=
FINEBI_SECRET=
# 应用身份调用时留空；需要以某个 FineBI 用户身份调用时再填用户名
FINEBI_DEC_USER=

# ---- 飞书自建应用 ----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APPROVAL_CODE=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_LEDGER_TABLE_ID=
FEISHU_BITABLE_RESOURCE_TABLE_ID=
# 权限申请台账表（Web 审批卡片/状态写入）
FEISHU_BITABLE_REQUEST_TABLE_ID=
FEISHU_WEBHOOK_URL=
FEISHU_ADMIN_OPEN_IDS=

# ---- 运行参数 ----
EXECUTOR_DB_PATH=data/executor.db
EXECUTOR_DRY_RUN=true
EXECUTOR_DEFAULT_DAYS=90
EXECUTOR_MAX_DAYS=365
EXECUTOR_HTTP_TIMEOUT=20
EXECUTOR_LOG_LEVEL=INFO
EXECUTOR_API_TOKEN=
EXECUTOR_LOCK_TTL=120
EXECUTOR_ROW_CLEAR_STRATEGY=manual
EXECUTOR_ROLE_MODE=api
EXECUTOR_ADOPT_EXISTING=false
EXECUTOR_BITABLE_WRITE=false
# 目录/角色/部门定时刷新周期（小时）
EXECUTOR_DIRECTORY_REFRESH_HOURS=6

# ---- 自建 Web 审批 ----
WEB_AUTH_MODE=dev
PUBLIC_BASE_URL=
FEISHU_OAUTH_REDIRECT_URI=
# 需要手机号/邮箱匹配 FineBI 账号时，先在飞书应用开通对应权限，再填 scope
# 例：contact:user.phone:readonly contact:user.email:readonly
FEISHU_OAUTH_SCOPE=

# ---- 后台管理独立登录（与飞书登录隔离） ----
# 用 python -m executor.cli admin-password 生成哈希后粘贴到 ADMIN_PASSWORD_HASH
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# ---- FineDB 只读（可选：飞书映射/行权限枚举） ----
FINE_DB_HOST=
FINE_DB_PORT=3306
FINE_DB_USER=
FINE_DB_PASSWORD=
FINE_DB_NAME=finedb
