# /etc/cron.d/finebi-directory-refresh
# 备选方案：没有 systemd 的 Linux 用 cron（不补跑关机期间错过的任务）。
# 按实际部署路径和运行用户修改；建议与 Web 服务同一用户，保证快照可读。
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
0 */6 * * * finebi cd /opt/finebi-feishu && PYTHONPATH=src .venv/bin/python -m executor.cli refresh-directory >> data/directory_refresh.log 2>&1
