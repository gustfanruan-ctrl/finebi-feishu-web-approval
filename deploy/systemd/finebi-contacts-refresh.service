[Unit]
Description=FineBI x Feishu contact snapshot refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# 按实际部署路径/用户修改
User=finebi
Group=finebi
WorkingDirectory=/opt/finebi-feishu
Environment=PYTHONPATH=/opt/finebi-feishu/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/finebi-feishu/.venv/bin/python -m executor.cli sync-contacts \
    --status-json data/contacts_status.json
